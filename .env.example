# Visitor + presence counters (Upstash Redis).
# Provision: Vercel dashboard -> Storage -> Marketplace -> Upstash Redis.
# Vercel injects KV_REST_API_URL / KV_REST_API_TOKEN automatically once linked.
# Provisioning straight from upstash.com instead? Use the UPSTASH_ names.
# Unset = counters silently disabled, site works normally.
KV_REST_API_URL=
KV_REST_API_TOKEN=
